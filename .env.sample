# Copy to .env in the project root (or pass --env <file>). Every field is optional:
# missing or blank values are simply omitted from the card, not replaced with placeholder text.
# Shell environment variables take precedence over this file.
CARD_AUTHOR=""
CARD_WEBSITE=""
CARD_SERIES=""
# Defaults to the author's initials when blank (and author is set).
CARD_MONOGRAM=""
# Optional large mark in the footer; blank hides it.
CARD_FOOTER_MARK=""
CARD_ISSUE_LABEL=""
# Optional: use an existing Chromium instead of Playwright's managed download.
# CARD_BROWSER_PATH=/usr/bin/chromium
