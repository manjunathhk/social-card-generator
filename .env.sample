# Copy to .env in the project root (or pass --env <file>). Missing or blank values use neutral defaults.
# Shell environment variables take precedence over this file.
CARD_AUTHOR="Your Name"
CARD_WEBSITE="example.com"
CARD_SERIES="Field Notes"
# Defaults to the author's initials when blank.
CARD_MONOGRAM=""
# Optional large mark in the footer; blank hides it.
CARD_FOOTER_MARK=""
CARD_ISSUE_LABEL="Note"
# Optional: use an existing Chromium instead of Playwright's managed download.
# CARD_BROWSER_PATH=/usr/bin/chromium
